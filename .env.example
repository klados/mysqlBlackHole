# Server port for MySQL black hole
PORT=3306

# TLS. Enabled by default: the server advertises CLIENT_SSL with an
# auto-generated self-signed certificate covering localhost/127.0.0.1/::1 plus
# anything in TLS_SANS. TLS is never required, so plaintext clients keep working.
# Set to "false" to stop advertising CLIENT_SSL entirely.
TLS_ENABLED=true

# Extra comma-separated hostnames/IPs to put in the auto-generated certificate.
# Only used when TLS_CERT_FILE/TLS_KEY_FILE are unset.
# TLS_SANS=mysql.example.com,10.0.0.5

# Load a real PEM certificate/key instead of the generated self-signed one.
# TLS_CERT_FILE=/path/to/server.crt
# TLS_KEY_FILE=/path/to/server.key

# Redis.
# Default targets the Docker Compose redis service. Shell/env vars set by
# CI (e.g. GitHub Actions) take precedence over this file, so production
# deploys need no .env at all. For host runs use: REDIS_ADDR=localhost:6379 go run .
REDIS_ADDR=redis:6379