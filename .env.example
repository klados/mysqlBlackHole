# Server port for MySQL black hole
PORT=3306

# Redis.
# Default targets the Docker Compose redis service. Shell/env vars set by
# CI (e.g. GitHub Actions) take precedence over this file, so production
# deploys need no .env at all. For host runs use: REDIS_ADDR=localhost:6379 go run .
REDIS_ADDR=redis:6379

# Elasticsearch (report generator only: cmd/report_generator).
# The compose service binds 127.0.0.1:9200 (like redis/kibana), so host runs
# work directly when the stack is local. On a remote server, reach it through
# an SSH tunnel: ssh -L 9200:localhost:9200 user@server
# Inside the compose network the address is http://elasticsearch:9200.
ELASTICSEARCH_URL=http://localhost:9200

# Elasticsearch index Vector ships logs to (see vector.yaml).
ES_INDEX=mysqlblackhole
DISCORD_REPORT_WEBHOOK=

# Daily report schedule (Ofelia job-run in docker-compose.yml).
# Ofelia 0.3.x uses robfig/cron v1, whose FIRST field is SECONDS (required):
# 6-field Quartz form "sec min hour dom mon dow" = 08:00 UTC every day.
REPORT_SCHEDULE=0 0 8 * * *
# Lookback window passed as --window to the report generator.
REPORT_WINDOW=24h