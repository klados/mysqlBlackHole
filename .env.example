# Server port for MySQL black hole
PORT=3306

# Redis.
# Default targets the Docker Compose redis service. Shell/env vars set by
# CI (e.g. GitHub Actions) take precedence over this file, so production
# deploys need no .env at all. For host runs use: REDIS_ADDR=localhost:6379 go run .
REDIS_ADDR=redis:6379

# Honeypot credentials override (format "user:pass,user2:pass2").
# Overrides the PUBLIC DECOY passwords in cmd/seed-redis/seed_data.yaml.
# Set this in production / CI secrets so the live honeypot never uses the
# published decoys. Leave unset for local dev.
# HONEYPOT_USERS=root:change-me,app:change-me-too
